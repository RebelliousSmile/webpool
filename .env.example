# Connexion PostgreSQL (défaut : conteneur docker-compose local)
DATABASE_URL=postgres://webpool:webpool@localhost:5432/webpool

# Port hôte exposé par docker-compose (défaut 5432)
WEBPOOL_DB_PORT=5432

# Clé API Brave Search (provider SERP réel, optionnel — le provider `file` fonctionne sans)
BRAVE_API_KEY=

# Politesse réseau de `webpool normalize` (en ligne)
# Délai minimal entre deux requêtes vers un même hôte (ms)
WEBPOOL_HOST_DELAY_MS=1000
# Nombre de nouvelles tentatives sur erreur transitoire (timeout, 429, 5xx), backoff exponentiel
WEBPOOL_FETCH_RETRIES=2
WEBPOOL_FETCH_BACKOFF_MS=500
# Octets lus au maximum par page (seul le <head> est utile)
WEBPOOL_MAX_BODY_BYTES=262144
# Requêtes simultanées entre hôtes différents
WEBPOOL_CONCURRENCY=4
# Timeout par requête (ms)
WEBPOOL_FETCH_TIMEOUT_MS=10000
