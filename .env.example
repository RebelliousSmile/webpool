# Connexion PostgreSQL (défaut : conteneur docker-compose local)
DATABASE_URL=postgres://webpool:webpool@localhost:5432/webpool

# Port hôte exposé par docker-compose (défaut 5432)
WEBPOOL_DB_PORT=5432

OPENROUTER_API_KEY=

# Providers SERP — tous optionnels, le provider `file` fonctionne sans.
# Brave Search : https://api-dashboard.search.brave.com
BRAVE_API_KEY=
# SearXNG auto-hébergé (sans clé) : URL de base de l'instance, format JSON activé
# (search.formats: [html, json] dans settings.yml). Ex. http://localhost:8080
SEARXNG_URL=
# Europeana (patrimoine culturel) : clé gratuite https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=
# Flickr (photos) : clé gratuite https://www.flickr.com/services/api/misc.api_keys.html
FLICKR_API_KEY=

# Politesse réseau de `webpool normalize` (en ligne)
# Délai minimal entre deux requêtes vers un même hôte (ms)
WEBPOOL_HOST_DELAY_MS=1000
# Nombre de nouvelles tentatives sur erreur transitoire (timeout, 429, 5xx), backoff exponentiel
WEBPOOL_FETCH_RETRIES=2
WEBPOOL_FETCH_BACKOFF_MS=500
# Octets lus au maximum par page (seul le <head> est utile)
WEBPOOL_MAX_BODY_BYTES=262144
# Requêtes simultanées entre hôtes différents
WEBPOOL_CONCURRENCY=4
# Timeout par requête (ms)
WEBPOOL_FETCH_TIMEOUT_MS=10000

# API HTTP (webpool serve). PORT et IP fournis par l'hébergeur sont repris par défaut.
WEBPOOL_API_PORT=3000
WEBPOOL_API_HOST=127.0.0.1
# Origines autorisées par CORS, séparées par des virgules (ex. l'interface datapool)
WEBPOOL_API_CORS_ORIGINS=http://localhost:5173

# Médias (webpool media) : cache des vignettes et favicons, hors du dossier
# remplacé au déploiement (alwaysdata : $HOME/www/webpool-data/media)
WEBPOOL_MEDIA_DIR=
WEBPOOL_MEDIA_MAX_BYTES=5242880
WEBPOOL_MEDIA_CONCURRENCY=4
