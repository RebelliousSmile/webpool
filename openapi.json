{
  "openapi": "3.1.0",
  "info": {
    "title": "webpool API",
    "version": "1.0.0",
    "description": "API HTTP en lecture seule de webpool (`webpool serve`). Authentification par jeton `Authorization: Bearer`, créé avec `webpool client add`. Un client `read` ne voit que les pools qui lui sont accordés (`webpool client grant`) ; les routes `/admin` sont réservées aux clients `admin`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "public"
    },
    {
      "name": "pools",
      "description": "Clients read et admin"
    },
    {
      "name": "admin",
      "description": "Clients admin"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "État du service et de la base",
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Ce document",
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/me": {
      "get": {
        "summary": "Client authentifié",
        "tags": [
          "pools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/pools": {
      "get": {
        "summary": "Pools visibles (tous pour admin, accordés pour read)",
        "tags": [
          "pools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PoolSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/pools/{slug}": {
      "get": {
        "summary": "Détail d'un pool : volumes, domaines principaux, usage commercial",
        "tags": [
          "pools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pool"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "`definition` et `created_at` ne sont renvoyés qu'aux clients admin. Un pool non accordé répond 404.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/pools/{slug}/items": {
      "get": {
        "summary": "URLs du pool, dans l'ordre de rang",
        "tags": [
          "pools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PoolItem"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "`id` et `score` ne sont renvoyés qu'aux clients admin.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          }
        ]
      }
    },
    "/admin/stats": {
      "get": {
        "summary": "Volumes du corpus, des runs, des domaines et de la frontière",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/pools/{slug}/export": {
      "get": {
        "summary": "Export d'un pool (format de `webpool pool export`)",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Fichier",
            "content": {
              "application/json": {},
              "text/csv": {},
              "text/markdown": {}
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "md"
              ],
              "default": "json"
            }
          }
        ]
      }
    },
    "/admin/urls": {
      "get": {
        "summary": "Corpus filtré",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/UrlSummary"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Statut",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "normalized",
                "classified",
                "duplicate",
                "error"
              ]
            }
          },
          {
            "name": "theme",
            "in": "query",
            "description": "Slug d'un thème ou sous-thème rattaché",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "facet",
            "in": "query",
            "description": "slug:valeur, répétable (toutes exigées)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "domain",
            "in": "query",
            "description": "Domaine exact",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Texte cherché dans le titre et l'URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Ordre",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "quality",
                "relevance"
              ],
              "default": "recent"
            }
          }
        ]
      }
    },
    "/admin/urls/{id}": {
      "get": {
        "summary": "Fiche d'une URL : sources, thèmes, facettes, pools",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Url"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/admin/themes": {
      "get": {
        "summary": "Arbre de la taxonomie avec volumes",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Theme"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/facets": {
      "get": {
        "summary": "Facettes et répartition de leurs valeurs",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Facet"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/domains": {
      "get": {
        "summary": "Registre des domaines",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Domain"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "name": "to_qualify",
            "in": "query",
            "description": "true : usage commercial non qualifié ; false : qualifié",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "excluded",
            "in": "query",
            "description": "Exclu de l'exploration",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "usage",
            "in": "query",
            "description": "Usage commercial",
            "schema": {
              "type": "string",
              "enum": [
                "libre",
                "sous-conditions",
                "payant",
                "non-commercial"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Texte cherché dans le domaine",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/admin/queries": {
      "get": {
        "summary": "Frontière d'exploration : requêtes et rendement",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SearchQuery"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Statut",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "exhausted",
                "paused"
              ]
            }
          },
          {
            "name": "provider",
            "in": "query",
            "description": "Provider",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/admin/runs": {
      "get": {
        "summary": "Historique des exécutions du pipeline, plus récentes d'abord",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Run"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Type",
            "schema": {
              "type": "string",
              "enum": [
                "ingest",
                "normalize",
                "classify",
                "pool",
                "explore"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Statut",
            "schema": {
              "type": "string",
              "enum": [
                "running",
                "done",
                "failed"
              ]
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        }
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Paramètre invalide",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Jeton absent, invalide ou révoqué",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Réservé aux clients admin",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Introuvable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "name",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "admin",
              "read"
            ]
          }
        }
      },
      "PoolSummary": {
        "type": "object",
        "required": [
          "slug",
          "label",
          "refreshed_at",
          "items"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "refreshed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "items": {
            "type": "integer"
          }
        }
      },
      "Pool": {
        "type": "object",
        "required": [
          "slug",
          "label",
          "refreshed_at",
          "items",
          "top_domains",
          "usage_commercial"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "refreshed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "items": {
            "type": "integer"
          },
          "top_domains": {
            "type": "array",
            "description": "20 domaines les plus représentés",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "urls": {
                  "type": "integer"
                }
              }
            }
          },
          "usage_commercial": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "usage": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "libre",
                    "sous-conditions",
                    "payant",
                    "non-commercial",
                    null
                  ]
                },
                "urls": {
                  "type": "integer"
                }
              }
            }
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "admin uniquement"
          },
          "definition": {
            "type": "object",
            "description": "admin uniquement : définition réexécutable du pool"
          }
        }
      },
      "PoolItem": {
        "type": "object",
        "required": [
          "rank",
          "url",
          "domain",
          "title",
          "usage_commercial"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage_commercial": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "libre",
              "sous-conditions",
              "payant",
              "non-commercial",
              null
            ]
          },
          "id": {
            "type": "integer",
            "description": "admin uniquement"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "admin uniquement"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "url_item": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "n": {
                  "type": "integer"
                }
              }
            }
          },
          "processing_run": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "n": {
                  "type": "integer"
                }
              }
            }
          },
          "pools": {
            "type": "integer"
          },
          "domain_profile": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "to_qualify": {
                "type": "integer"
              },
              "excluded": {
                "type": "integer"
              }
            }
          },
          "search_query": {
