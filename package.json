{
  "name": "webpool",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Corpus d'URLs normalisées, classées par taxonomie, restituées en pools matérialisés (PostgreSQL).",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "bin": {
    "webpool": "bin/webpool.js"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait && node bin/webpool.js migrate",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && node bin/webpool.js migrate",
    "webpool": "node bin/webpool.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "deploy:prod": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "test:coverage": "WEBPOOL_IT_REQUIRED=1 vitest run --config vitest.coverage.config.js --coverage"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
